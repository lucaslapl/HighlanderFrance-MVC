# Copiez ce fichier vers config/.env puis renseignez les valeurs réelles.
# config/.env est exclu du versionnement (voir .gitignore).

STEAM_API_KEY=

# URL publique de l'application (vhost).
APP_URL=http://localhost:8080

# Mode debug (1 en dev, 0/vide en production). Active l'affichage des erreurs.
APP_DEBUG=1

# Base SQLite. Laisser vide pour utiliser le défaut : _scripts/stats.db
DB_PATH=

# Vérification SSL pour les appels cURL (0 sur WAMP, 1 en production).
CURL_VERIFY_SSL=0

# Token partage avec le plugin SourceMod hlfr_match_log, webhook fin de match.
# Doit correspondre a hlfr_webhook_token dans la config du plugin.
SERVER_WEBHOOK_TOKEN=

# IP des serveurs de match autorises a declencher le webhook. Vide = toutes.
SERVER_WEBHOOK_ALLOWED_IPS=
