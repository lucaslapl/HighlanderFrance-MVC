# Copiez ce fichier vers config/.env puis renseignez les valeurs réelles.
# config/.env est exclu du versionnement (voir .gitignore).

STEAM_API_KEY=

# URL publique de l'application (vhost).
APP_URL=http://localhost:8080

# Base SQLite. Laisser vide pour utiliser le défaut : _scripts/stats.db
DB_PATH=

# Vérification SSL pour les appels cURL (0 sur WAMP, 1 en production).
CURL_VERIFY_SSL=0
