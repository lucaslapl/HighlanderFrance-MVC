Options -Indexes

# ─────────────────────────────────────────────────────────────────────────────
# En-têtes de sécurité
# ─────────────────────────────────────────────────────────────────────────────
# NB : la Content-Security-Policy est volontairement absente ici : le kit Font
# Awesome et les nombreux scripts inline du site la rendent complexe à calibrer.
# À réintroduire via des nonces lors d'une refonte des assets (à faire).
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# ─────────────────────────────────────────────────────────────────────────────
# Réécritures / protection d'accès
# ─────────────────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Interdiction d'accès aux dossiers internes
    RewriteRule ^(?:app|config|bin|_cache|_sessions|_scripts)(?:/|$) - [F,L,NC]

    # Interdiction d'accès au dépôt git et aux fichiers/dossiers dotfiles
    # (sauf .well-known), fichiers .env et bases de données.
    RewriteRule (^|/)\.git(/|$) - [F,L,NC]
    RewriteRule (^|/)\.(?!well-known) - [F,L,NC]
    RewriteRule ^(?:.*/)?\.env$ - [F,L,NC]
    RewriteRule \.(?:db|sqlite|sqlite3)$ - [F,L,NC]

    # Front controller : tout ce qui n'est pas un fichier ou dossier réel
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
