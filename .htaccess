Options -Indexes

# ─────────────────────────────────────────────────────────────────────────────
# En-têtes de sécurité
# ─────────────────────────────────────────────────────────────────────────────
# NB : la Content-Security-Policy est volontairement absente ici : le kit Font
# Awesome et les nombreux scripts inline du site la rendent complexe à calibrer.
# À réintroduire via des nonces lors d'une refonte des assets (à faire).
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# ─────────────────────────────────────────────────────────────────────────────
# Performances : compression + cache navigateur pour les assets statiques
# ─────────────────────────────────────────────────────────────────────────────
# Compression gzip des ressources textuelles.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml application/rss+xml
</IfModule>

# Cache navigateur par type de ressource.
<IfModule mod_headers.c>
    # HTML jamais mis en cache (rendu dynamique).
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
    </FilesMatch>

    # Assets immuables liés au buzz de cache (versionnés via ?v=).
    <FilesMatch "\.(css|js|woff2?|ttf|eot|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Images et fichiers statiques peu volatils.
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|webmanifest|xml|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# Réécritures / protection d'accès
# ─────────────────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Interdiction d'accès aux dossiers internes
    RewriteRule ^(?:app|config|bin|_cache|_sessions|_scripts)(?:/|$) - [F,L,NC]

    # Interdiction d'accès au dépôt git et aux fichiers/dossiers dotfiles
    # (sauf .well-known), fichiers .env et bases de données.
    RewriteRule (^|/)\.git(/|$) - [F,L,NC]
    RewriteRule (^|/)\.(?!well-known) - [F,L,NC]
    RewriteRule ^(?:.*/)?\.env$ - [F,L,NC]
    RewriteRule \.(?:db|sqlite|sqlite3)$ - [F,L,NC]

    # Les sourcemaps (.map) ne doivent pas être servies en production :
    # elles exposent le code source SCSS/JS d'origine.
    RewriteRule \.(?:css|js)\.map$ - [F,L,NC]

    # Front controller : tout ce qui n'est pas un fichier ou dossier réel
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
